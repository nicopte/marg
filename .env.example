# Base de datos PostgreSQL (Neon, Supabase, Vercel Postgres, Railway, etc.)
# En Vercel: Project Settings -> Environment Variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# URL de conexiones directas (Neon/Supabase la proveen; si tu proveedor no tiene, repetí la de arriba)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Mercado Pago (Checkout Pro)
# Access Token de producción (Generar claves -> Production) y Public Key
MP_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
